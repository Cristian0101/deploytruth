{
  "name": "deploytruth-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "git status for your deployed application",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --if-present run build",
    "build:action": "pnpm --filter @deploytruth/github-action run build",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "release:check": "pnpm install --frozen-lockfile && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm release:check:artifacts && pnpm test:e2e",
    "release:check:artifacts": "git diff --exit-code -- packages/github-action/dist && node scripts/pack-check.mjs && node scripts/external-consumer-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
